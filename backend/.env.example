# backend/.env.example - AGENT CAPITAL Backend Configuration

# Server Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug

# 0G Storage Endpoints
OG_KV_ENDPOINT=http://localhost:8080
OG_LOG_ENDPOINT=http://localhost:8081
OG_STORE_NAMESPACE=agent-capital

# 0G Compute Endpoints
OG_COMPUTE_ENDPOINT=http://localhost:8000
OG_COMPUTE_API_KEY=test-key-replace-with-actual
OG_COMPUTE_ROUTER=https://router.testnet.0g.ai

# Blockchain Configuration
0G_RPC_URL=https://evmrpc-testnet.0g.ai
0G_NETWORK_ID=16602
0G_CHAIN_NAME=0G Galileo Testnet

# Smart Contract Addresses (after deployment)
AGENT_CAPITAL_ADDRESS=0x...
AGENT_NFT_ADDRESS=0x...
AGENT_MARKETPLACE_ADDRESS=0x...
AGENT_BREEDING_ADDRESS=0x...
PROOF_OF_TRADE_ADDRESS=0x...

# Deployment Keys
DEPLOYER_PRIVATE_KEY=your-private-key-here
DEPLOYER_ADDRESS=your-address-here

# Database / 0G Storage
DEMO_MODE=true
USE_MOCK_DATA=true
MOCK_AGENT_COUNT=50
MOCK_TVL=2500000

# Feature Flags
ENABLE_TRADING=true
ENABLE_BREEDING=true
ENABLE_MARKETPLACE=true
ENABLE_ANALYTICS=true
ENABLE_REAL_TIME_UPDATES=true

# WebSocket Configuration
WS_PORT=5000
WS_HEARTBEAT_INTERVAL=30000
WS_MAX_CLIENTS=1000

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging & Monitoring
LOG_TO_CONSOLE=true
LOG_TO_FILE=false
LOG_FILE_PATH=./logs/agent-capital.log
SENTRY_DSN=

# Dividend Distribution
HOLDER_DIVIDEND_PERCENTAGE=70
BREEDING_FUND_PERCENTAGE=20
PLATFORM_FEE_PERCENTAGE=10

# Agent Configuration
MIN_AGENT_ACCURACY_FOR_BREEDING=75
AGENT_ACCURACY_IMPROVEMENT_PER_WIN=1
AGENT_ACCURACY_DEGRADATION_PER_LOSS=1
MAX_AGENT_ACCURACY=100
MIN_AGENT_ACCURACY=5

# Marketplace Configuration
MARKETPLACE_FEE_PERCENTAGE=5
PRICE_FLOOR_MULTIPLIER=1
PRICE_CEILING_MULTIPLIER=10

# Breeding Configuration
BREEDING_FEE_AMOUNT=0.5
PARENT_ROYALTY_PERCENTAGE=250  # 2.5% in basis points

# Admin Configuration
ADMIN_ADDRESS=your-admin-address
EMERGENCY_PAUSE=false

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFICATIONS_ENABLED=false

# Analytics
ANALYTICS_ENABLED=true
TRACK_TRADES=true
TRACK_BREEDING=true
TRACK_MARKETPLACE_VOLUME=true

# Performance
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CONNECTION_POOL_SIZE=20
MAX_REQUEST_SIZE_MB=10

# Security
CORS_ORIGIN=http://localhost:3000
SESSION_SECRET=your-secret-key-change-in-production
JWT_SECRET=your-jwt-secret-change-in-production
