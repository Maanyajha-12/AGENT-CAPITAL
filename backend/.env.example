# ============================================================
# AGENT CAPITAL — Backend Environment Variables (.env.example)
# Copy this to .env and fill in your values
# ============================================================

# LLM API Keys
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE
OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE

# 0G Compute Router (get key at https://pc.testnet.0g.ai)
OG_COMPUTE_ENDPOINT=https://router-api-testnet.integratenetwork.work/v1
OG_COMPUTE_ROUTER_API_KEY=sk-YOUR_KEY_HERE
OG_COMPUTE_MODEL=deepseek-chat-v3

# 0G Storage (local nodes, falls back to in-memory if unavailable)
OG_KV_ENDPOINT=http://localhost:8080
OG_LOG_ENDPOINT=http://localhost:8081

# Blockchain — 0G Galileo Testnet (Chain ID: 16602)
# Explorer: https://chainscan-galileo.0g.ai
# Faucet:   https://faucet.0g.ai
RPC_URL=https://evmrpc-testnet.0g.ai
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
CHAIN_ID=16602

# Contract Addresses (deployed to 0G Galileo — Block 30912464)
DELIBERATION_INFT_ADDRESS=0x1cd62cb08754a12fcc3427559e616a2898812d59
AGENT_REGISTRY_ADDRESS=0xc8106baf71c3a38177167edf51ac1391cbb8e2e6
PROOF_OF_INTELLIGENCE_ADDRESS=0xdc83dd755ba02265d23922104b0b54c304537bf2
TOURNAMENT_ARENA_ADDRESS=0x52e4fc0de6b1ecc7b48375e5a9135fb41236f668
CROSS_CHAIN_BRIDGE_ADDRESS=0x8417b73a19a1db21a10d0737fb8bbd469ee21545

# Server
PORT=5000
NODE_ENV=production
EXECUTION_MODE=simulation
MAX_REVISIONS=2
LOG_LEVEL=info
