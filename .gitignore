# ===================================
# AGENT CAPITAL — .gitignore
# ===================================

# Dependencies
node_modules/

# Build outputs
dist/
build/
out/

# Environment variables (NEVER commit keys)
.env
.env.local
.env.production
backend/.env
frontend/.env
frontend/.env.local

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-*

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Foundry (Solidity)
contracts/cache/
contracts/out/
contracts/broadcast/

# Vercel
frontend/.vercel/

# TypeScript build cache
*.tsbuildinfo

# Test / Coverage
coverage/
.nyc_output/

# Temporary files
*.tmp
*.bak
*.orig

# ===================================
# Generated / Internal docs
# Not needed in public repo
# ===================================

